# Server Port Configuration
PORT=8000

# Database Connection (Postgres / CockroachDB)
DATABASE_URL=postgresql://whiteboard_user:whiteboard_password@db:5432/whiteboard

# Redis Cluster Cache & Pub/Sub Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default

# JWT Secrets for Auth (Rotate regularly in production)
JWT_ACCESS_SECRET=your-jwt-access-secret-minimum-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# Allowed Client Origin (Comma-separated for multiple)
CLIENT_URL=http://localhost
CORS_ORIGIN=http://localhost,http://localhost:5173
